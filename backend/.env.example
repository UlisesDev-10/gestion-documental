# Configuración de Entorno - Backend
PROJECT_NAME="Plataforma de Gestión Documental"
ENVIRONMENT="development"
DEBUG=True

# Base de Datos PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gestion_documental_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gestion_documental_db

# Seguridad y Autenticación JWT
SECRET_KEY=cambiar_esta_clave_secreta_super_segura_en_produccion_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Almacenamiento Físico de Binarios
STORAGE_PATH=./storage
MAX_FILE_SIZE_BYTES=524288000 # 500 MB en bytes

# Concurrencia y Bloqueos
DEFAULT_LOCK_TTL_MINUTES=30
